# Copy to .env (never commit it). / Copia a .env (nunca lo subas al repo).

# Gemini API key (https://aistudio.google.com/apikey). Used from phase 5. / Se usa desde la fase 5.
GEMINI_API_KEY=

# Optional: path to a YAML config that overrides config/default.yaml
# Opcional: ruta a un YAML que sustituye a config/default.yaml
# PIT_WALL_CONFIG=config/local.yaml

# Optional: an ACTI .ld log used by the real-data tests / Opcional: log .ld de ACTI para los tests con datos reales
# PIT_WALL_SAMPLE_LD=C:\path\to\session.ld
